{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Orion",
  "version": "0.1.1",
  "identifier": "com.orion.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Orion",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../python-runtime": "python-runtime",
      "../../backend": "backend",
      "../../src": "src",
      "../../data/tts": "data/tts"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUyQkVCRDQxQUIwNkMyMTUKUldRVndnYXJRYjIrNHY1ZUlKdGRuQjB5UmdGRm0zOTNNNUdRU2oxL2hKT3ZjcXMvRjNXMUZ0T2IK",
      "endpoints": [
        "https://github.com/Ralf090102/Orion/releases/latest/download/latest.json"
      ]
    }
  }
}
